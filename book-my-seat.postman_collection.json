{
  "info": {
    "_postman_id": "b00kmys3at-c0ll-ection0001",
    "name": "Book My Seat",
    "description": "Seat-reservation system of record. Run folders top to bottom; test scripts chain baseUrl, tokens, showId and reservationId automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "dev-admin-token" },
    { "key": "adminJwt", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "userToken2", "value": "" },
    { "key": "showId", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get USER token (alice)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"user_id\":\"alice\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"has token\", function () { pm.expect(json.token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"userToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get second USER token (bob)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"user_id\":\"bob\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"userToken2\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ADMIN token (bootstrap secret)",
          "description": "Mints a short-lived ADMIN JWT. Requires the server's ADMIN_TOKEN secret as bearer; the static secret also works directly on admin routes as fallback.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"user_id\":\"ops\",\"role\":\"ADMIN\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"role is ADMIN\", function () { pm.expect(pm.response.json().role).to.eql(\"ADMIN\"); });",
                  "pm.collectionVariables.set(\"adminJwt\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shows",
      "item": [
        {
          "name": "Create show (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Rock Night\",\"seats\":[\"A1\",\"A2\",\"A3\",\"A4\",\"A5\"],\"price_paise\":25000}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"showId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create show as USER (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Nope\",\"seats\":[\"B1\"],\"price_paise\":100}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"code is FORBIDDEN\", function () { pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get show state",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/shows/{{showId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"invariant holds\", function () {",
                  "  var c = pm.response.json().counts;",
                  "  pm.expect(c.available + c.held + c.confirmed).to.eql(pm.response.json().total_seats);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get show summary",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/shows/{{showId}}?summary=true" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"no seats list\", function () { pm.expect(pm.response.json().seats).to.be.undefined; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reserve",
      "item": [
        {
          "name": "Reserve seat (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":[\"A1\"],\"idempotency_key\":\"postman-1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows/{{showId}}/reserve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 or replay 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"owner is alice\", function () { pm.expect(pm.response.json().user_id).to.eql(\"alice\"); });",
                  "pm.collectionVariables.set(\"reservationId\", pm.response.json().reservation_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same key (200 + header)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":[\"A1\"],\"idempotency_key\":\"postman-1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows/{{showId}}/reserve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"replay header\", function () { pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"); });",
                  "pm.test(\"same reservation\", function () { pm.expect(pm.response.json().reservation_id).to.eql(pm.collectionVariables.get(\"reservationId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key different seats (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":[\"A2\"],\"idempotency_key\":\"postman-1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows/{{showId}}/reserve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"key reused\", function () { pm.expect(pm.response.json().error.code).to.eql(\"IDEMPOTENCY_KEY_REUSED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Taken seat as bob (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken2}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":[\"A1\"],\"idempotency_key\":\"postman-bob-1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows/{{showId}}/reserve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"seat taken\", function () { pm.expect(pm.response.json().error.code).to.eql(\"SEAT_TAKEN\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cancel",
      "item": [
        {
          "name": "Non-owner cancel (403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken2}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner cancel (200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/reservations/{{reservationId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"cancelled\", function () { pm.expect(pm.response.json().status).to.eql(\"cancelled\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-book freed seat (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken2}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":[\"A1\"],\"idempotency_key\":\"postman-rebook-1\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/shows/{{showId}}/reserve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 or replay 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"owner is bob\", function () { pm.expect(pm.response.json().user_id).to.eql(\"bob\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Observe",
      "item": [
        {
          "name": "Liveness",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health/live" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health/ready" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"]
              }
            }
          ]
        },
        {
          "name": "Metrics",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/metrics" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"has confirmed counter\", function () { pm.expect(pm.response.text()).to.include(\"bookmyseat_reservations_confirmed_total\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
